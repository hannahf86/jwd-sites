# ============================================================
# JWD Sites dashboard — environment
# ============================================================
# Copy to .env.local for development. On Vercel these go in
# Project Settings → Environment Variables.

# --- Supabase ---------------------------------------------------------
# Project Settings → API Keys. The URL and publishable key are public by
# design: the key ships in the browser bundle, and on its own it can only
# read published content. Signed-in requests are privileged because of the
# session cookie riding with them, and RLS decides what they see.
# (A legacy "anon" key works here too.)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The secret key BYPASSES row level security. The dashboard uses it for one
# job only: creating accounts when an editor is invited. Never expose it to
# the browser, and never prefix it NEXT_PUBLIC_.
# (A legacy "service_role" key works here too.)
SUPABASE_SECRET_KEY=

# --- The app ----------------------------------------------------------
# Used to build invite and password-reset links. No trailing slash.
# Must also be listed in Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3108

# --- Telling client websites to refresh after a publish ---------------
# Each site gets its own secret derived from this one (see
# src/lib/revalidate.ts), so this value never leaves the dashboard.
# Generate one: openssl rand -hex 32. Optional until a site has a
# revalidate_url; without it, sites pick changes up when their cache expires.
REVALIDATE_SECRET=
